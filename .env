# Backend MySQL connection (used in server.js)
DB_HOST=altaria.proxy.rlwy.net
DB_USER=root
DB_PASS=123456
DB_NAME=gas_shop_db
DB_PORT=3306

# Backend server port
PORT=5000

# Frontend API URL (used in Vue/Vite)
VITE_API_URL=https://gas-shop-rwanda.onrender.com

# Google OAuth client ID (used by both backend and frontend)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
